// datasource db defines the database connection settings.
// It's configured for SQL Server and uses an environment variable for the connection URL.
datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// generator client specifies that Prisma Client should be generated for JavaScript/TypeScript.
generator client {
  provider = "prisma-client-js"
}

// ---------- ENUMS ----------

enum UserStatus {
  Active
  Inactive
}

enum LoanRepaymentStatus {
  Paid
  Unpaid
}

enum LoanApplicationStatus {
  PENDING_DOCUMENTS
  PENDING_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  NEEDS_REVISION
}

enum RepaymentBehavior {
  EARLY
  ON_TIME
  LATE
  NOT_APPLICABLE
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChangeRequestType {
  CREATE
  UPDATE
  DELETE
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
}


// ---------- MODELS ----------

// User model for platform administrators and other staff.
model User {
  id             String       @id @default(cuid())
  fullName       String
  email          String       @unique
  phoneNumber    String       @unique
  password       String
  status         UserStatus   @default(Active)
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])
  loanProviderId String?
  loanProvider   LoanProvider? @relation(fields: [loanProviderId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations for change requests
  createdChanges  PendingChange[] @relation("CreatedBy")
  approvedChanges PendingChange[] @relation("ApprovedBy")
}

// Role model for Role-Based Access Control (RBAC).
model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String // Stored as a JSON string
  users       User[]
}

// LoanProvider model represents a financial institution offering loans.
model LoanProvider {
  id                      String        @id @default(cuid())
  name                    String        @unique
  icon                    String
  colorHex                String
  displayOrder            Int
  accountNumber           String?
  startingCapital         Float
  initialBalance          Float
  allowCrossProviderLoans Boolean       @default(false)
  nplThresholdDays        Int           @default(60)
  status                  EntityStatus  @default(ACTIVE)
  // Relations
  users                   User[]
  products                LoanProduct[]
  dataProvisioningConfigs DataProvisioningConfig[]
  scoringParameters       ScoringParameter[]
  scoringHistory          ScoringConfigurationHistory[]
  termsAndConditions      TermsAndConditions[]
  journalEntries          JournalEntry[]
  ledgerAccounts          LedgerAccount[]
}

// LoanProduct model defines a specific loan offering from a provider.
model LoanProduct {
  id                      String                        @id @default(cuid())
  providerId              String
  name                    String
  description             String
  icon                    String
  minLoan                 Float?
  maxLoan                 Float?
  duration                Int?
  serviceFee              String? // JSON string for fee rules
  dailyFee                String? // JSON string for fee rules
  penaltyRules            String? // JSON string for penalty rules
  status                  EntityStatus                  @default(ACTIVE)
  allowConcurrentLoans    Boolean                       @default(false)
  serviceFeeEnabled       Boolean?
  dailyFeeEnabled         Boolean?
  penaltyRulesEnabled     Boolean?
  dataProvisioningEnabled Boolean?
  eligibilityFilter       String?                       @db.NVarChar(Max)
  dataProvisioningConfigId String?
  eligibilityUploadId     String?                       @unique
  // Relations
  provider                LoanProvider                  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  loans                   Loan[]
  applications            LoanApplication[]
  loanAmountTiers         LoanAmountTier[]
  requiredDocuments       RequiredDocument[]
  scoringConfigurations   ScoringConfigurationProduct[]
  eligibilityUpload       DataProvisioningUpload?       @relation(fields: [eligibilityUploadId], references: [id], onDelete: NoAction)
}

// Loan model for individual disbursed loans.
model Loan {
  id                String              @id @default(cuid())
  borrowerId        String
  productId         String
  loanApplicationId String?             @unique
  loanAmount        Float
  serviceFee        Float
  penaltyAmount     Float
  disbursedDate     DateTime
  dueDate           DateTime
  repaymentStatus   LoanRepaymentStatus
  repaidAmount      Float?
  repaymentBehavior RepaymentBehavior   @default(NOT_APPLICABLE)
  // Relations
  borrower          Borrower            @relation(fields: [borrowerId], references: [id])
  product           LoanProduct         @relation(fields: [productId], references: [id])
  application       LoanApplication?    @relation(fields: [loanApplicationId], references: [id])
  payments          Payment[]
  journalEntries    JournalEntry[]
}

// Borrower model represents an end-user taking a loan.
model Borrower {
  id              String             @id
  status          String? // e.g., 'NPL', 'Active'
  // Relations
  loans           Loan[]
  applications    LoanApplication[]
  provisionedData ProvisionedData[]
  agreements      BorrowerAgreement[]
  pendingPayments PendingPayment[]
}

// Payment model for recording repayments against a loan.
model Payment {
  id                              String       @id @default(cuid())
  loanId                          String
  amount                          Float
  date                            DateTime
  outstandingBalanceBeforePayment Float?
  journalEntryId                  String?      @unique
  // Relations
  loan                            Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  journalEntry                    JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: NoAction)
}

// LoanApplication model tracks the process before a loan is disbursed.
model LoanApplication {
  id                String                  @id @default(cuid())
  borrowerId        String
  productId         String
  loanAmount        Float?
  status            LoanApplicationStatus
  rejectionReason   String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  // Relations
  borrower          Borrower                @relation(fields: [borrowerId], references: [id])
  product           LoanProduct             @relation(fields: [productId], references: [id])
  loan              Loan?
  uploadedDocuments UploadedDocument[]
}

// Scoring models
model ScoringParameter {
  id         String @id @default(cuid())
  providerId String
  name       String
  weight     Int
  rules      Rule[]
  // Relations
  provider   LoanProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Rule {
  id          String           @id @default(cuid())
  parameterId String
  field       String
  condition   String
  value       String
  score       Int
  // Relations
  parameter   ScoringParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
}

model LoanAmountTier {
  id         String      @id @default(cuid())
  productId  String
  fromScore  Int
  toScore    Int
  loanAmount Float
  // Relations
  product    LoanProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Data Provisioning models for custom data upload
model DataProvisioningConfig {
  id         String                   @id @default(cuid())
  providerId String
  name       String
  columns    String                   @db.NVarChar(Max)
  // Relations
  provider   LoanProvider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  uploads    DataProvisioningUpload[]
  data       ProvisionedData[]
}

model DataProvisioningUpload {
  id         String            @id @default(cuid())
  configId   String
  fileName   String
  rowCount   Int
  uploadedAt DateTime          @default(now())
  uploadedBy String
  // Relations
  config     DataProvisioningConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  data       ProvisionedData[]
  product    LoanProduct?
}

model ProvisionedData {
  id        String                   @id @default(cuid())
  borrowerId String
  configId  String
  uploadId  String?
  data      String                   @db.NVarChar(Max)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  // Relations
  borrower  Borrower                 @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  config    DataProvisioningConfig   @relation(fields: [configId], references: [id], onDelete: Cascade)
  upload    DataProvisioningUpload?  @relation(fields: [uploadId], references: [id], onDelete: SetNull)

  @@unique([borrowerId, configId])
}

// Document Management models for SME loans
model RequiredDocument {
  id          String             @id @default(cuid())
  productId   String
  name        String
  description String?
  // Relations
  product     LoanProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploads     UploadedDocument[]
}

model UploadedDocument {
  id                 String           @id @default(cuid())
  loanApplicationId  String
  requiredDocumentId String
  fileName           String
  fileType           String
  fileContent        String           @db.NVarChar(Max) // Storing as base64 data URI
  status             String           @default("PENDING") // PENDING, APPROVED, REJECTED
  // Relations
  application      LoanApplication  @relation(fields: [loanApplicationId], references: [id], onDelete: Cascade)
  requiredDocument RequiredDocument @relation(fields: [requiredDocumentId], references: [id])

  @@unique([loanApplicationId, requiredDocumentId])
}

// Terms & Conditions models
model TermsAndConditions {
  id          String              @id @default(cuid())
  providerId  String
  content     String              @db.NVarChar(Max)
  version     Int
  isActive    Boolean             @default(true)
  publishedAt DateTime            @default(now())
  // Relations
  provider    LoanProvider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  agreements  BorrowerAgreement[]
}

model BorrowerAgreement {
  id         String             @id @default(cuid())
  borrowerId String
  termsId    String
  acceptedAt DateTime           @default(now())
  // Relations
  borrower   Borrower           @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  terms      TermsAndConditions @relation(fields: [termsId], references: [id])

  @@unique([borrowerId, termsId])
}


// --- ACCOUNTING & AUDITING ---

// AuditLog model for tracking significant actions.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String?
  entityId  String?
  details   String?  @db.NVarChar(Max) // Stored as JSON string
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model ScoringConfigurationHistory {
  id               String                        @id @default(cuid())
  providerId       String
  parameters       String                        @db.NVarChar(Max)
  savedAt          DateTime                      @default(now())
  // Relations
  provider         LoanProvider                  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  appliedProducts  ScoringConfigurationProduct[]
}

model ScoringConfigurationProduct {
  id         String                      @id @default(cuid())
  configId   String
  productId  String
  assignedBy String
  assignedAt DateTime                    @default(now())
  // Relations
  config     ScoringConfigurationHistory @relation(fields: [configId], references: [id], onDelete: Cascade)
  product    LoanProduct                 @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Accounting Models
model LedgerAccount {
  id         String         @id @default(cuid())
  providerId String
  name       String
  type       String // e.g., Asset, Liability, Income, Expense
  category   String // e.g., Principal, Interest, Penalty, ServiceFee
  balance    Float          @default(0.0)
  // Relations
  provider   LoanProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  entries    LedgerEntry[]
}

model JournalEntry {
  id          String        @id @default(cuid())
  providerId  String
  loanId      String?
  date        DateTime
  description String
  // Relations
  provider    LoanProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  loan        Loan?         @relation(fields: [loanId], references: [id], onDelete: NoAction)
  entries     LedgerEntry[]
  payments    Payment[]
}

model LedgerEntry {
  id              String        @id @default(cuid())
  journalEntryId  String
  ledgerAccountId String
  type            String // 'Debit' or 'Credit'
  amount          Float
  // Relations
  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: NoAction)
}


// --- Payment Gateway Models ---
model PendingPayment {
  id            String   @id @default(cuid())
  transactionId String   @unique
  loanId        String
  borrowerId    String
  amount        Float
  status        String // PENDING, COMPLETED, FAILED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // Relations
  borrower      Borrower @relation(fields: [borrowerId], references: [id])
}

model PaymentTransaction {
  id            String   @id @default(cuid())
  transactionId String   @unique
  status        String // e.g., RECEIVED, PROCESSED, FAILED
  payload       String   @db.NVarChar(Max)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Tax Configuration Model
model Tax {
  id        String  @id @default(cuid())
  name      String?
  rate      Float
  appliedTo String // JSON string array: ["serviceFee", "interest", "penalty"]
  status    EntityStatus @default(ACTIVE)
}

// MAKER-CHECKER MODEL
model PendingChange {
  id              String               @id @default(cuid())
  entityType      String // e.g., "LoanProvider", "LoanProduct", "ScoringRules", "Tax"
  entityId        String? // ID of the entity being changed (null for CREATE)
  changeType      ChangeRequestType // CREATE, UPDATE, DELETE
  payload         String               @db.NVarChar(Max) // JSON of the proposed data or changes
  status          ChangeRequestStatus  @default(PENDING)
  rejectionReason String?
  // Relations
  createdById     String
  createdBy       User                 @relation("CreatedBy", fields: [createdById], references: [id], onDelete: NoAction)
  approvedById    String?
  approvedBy      User?                @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: NoAction)
  createdAt       DateTime             @default(now())
  approvedAt      DateTime?
}
